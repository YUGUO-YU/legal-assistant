gateway:
  port: 8090
  auth:
    enabled: true
    jwtSecret: ${JWT_SECRET:-legal-assistant-secret-key-change-in-production}

channels:
  webchat:
    enabled: true
    webSocketPath: /ws/chat

agents:
  defaults:
    model: minimax/minimax2.7
    modelConfig:
      apiKey: ${MINIMAX_API_KEY}
      baseURL: ${MINIMAX_BASE_URL:-https://api.minimax.chat/v2}
    skills:
      - china-legal-query
      - china-contract-review
      - china-legal-analysis
      - mova-contract-generation
      - regulation-monitor
      - china-company-search
      - caseclaw
      - web-search
      - document-pro

mcp:
  servers:
    - name: legal-mcp
      url: http://backend:8080/api/mcp