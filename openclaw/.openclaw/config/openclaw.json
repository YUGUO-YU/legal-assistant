gateway:
  port: 8090
  auth:
    enabled: true
    jwtSecret: ${JWT_SECRET}

channels:
  webchat:
    enabled: true
    webSocketPath: /ws/chat

agents:
  defaults:
    model: openai/gpt-4
    skills:
      - china-legal-query
      - china-contract-review
      - china-legal-analysis
      - mova-contract-generation
      - regulation-monitor
      - china-company-search
      - caseclaw
      - web-search
      - document-pro

mcp:
  servers:
    - name: legal-mcp
      url: http://backend:8080/api/mcp